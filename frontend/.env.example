# URL base del backend (incluye /api/v1).
VITE_API_BASE_URL=https://gestion-activos-m1.onrender.com/api/v1

# Credenciales HTTP Basic configuradas en Render (SECURITY_USER / SECURITY_PASSWORD).
# En un sitio estático quedan visibles en el bundle: úsalo solo para la demo.
VITE_API_USERNAME=
VITE_API_PASSWORD=

# Tiempo máximo por petición. Render free puede tardar en despertar.
VITE_API_TIMEOUT_MS=60000

# true = datos de demostración en memoria; false = backend real.
VITE_DEMO_MODE=false
